NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/cricket_auction?replicaSet=rs0
JWT_SECRET=replace-this-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=12h
# Comma-separated browser origins. Use your deployed frontend origin in production.
CLIENT_ORIGIN=http://localhost:3000
# Required by npm run seed. Set these before seeding.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password
# Optional initial demo-team setup; set a password before running seed.
DEMO_TEAM_PASSWORD=
